Bootstrap: docker
From: nvidia/cuda:12.6.1-devel-ubuntu22.04

%environment
    export CUQUANTUM_ROOT=/opt/nvidia/cuquantum
    export LD_LIBRARY_PATH=/opt/nvidia/cuquantum/lib:$LD_LIBRARY_PATH
    export QNI_HTTP_PORT=${QNI_HTTP_PORT:-8000}
    export QNI_WEB_ROOT=/opt/qni-webgpu/apps/web/dist
    export QNI_QISKIT_BACKEND_HOST=127.0.0.1
    export QNI_QISKIT_BACKEND_PORT=${QNI_QISKIT_BACKEND_PORT:-4184}
    export QNI_QISKIT_RUNNER=qiskit-gpu
    export QNI_QISKIT_ALLOWED_RUNNERS=qiskit-gpu

%post -c /bin/bash
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive
    export CUQUANTUM_ROOT=/opt/nvidia/cuquantum
    export LD_LIBRARY_PATH=/opt/nvidia/cuquantum/lib:${LD_LIBRARY_PATH:-}

    apt-get update
    apt-get install -y --no-install-recommends \
        apache2-utils \
        binaryen \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        gettext-base \
        git \
        gnupg \
        libopenblas-dev \
        libssl-dev \
        nginx \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-skbuild \
        python3-venv \
        wget

    curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
    apt-get update
    apt-get install -y --no-install-recommends nodejs
    npm install -g pnpm@9.15.9

    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
    . /root/.cargo/env
    rustup target add wasm32-unknown-unknown
    cargo install trunk --locked

    wget -q https://developer.download.nvidia.com/compute/cuquantum/24.08.0/local_installers/cuquantum-local-repo-ubuntu2204-24.08.0_24.08.0-1_amd64.deb
    dpkg -i cuquantum-local-repo-ubuntu2204-24.08.0_24.08.0-1_amd64.deb
    cp /var/cuquantum-local-repo-ubuntu2204-24.08.0/cuquantum-*-keyring.gpg /usr/share/keyrings/
    wget -q https://developer.download.nvidia.com/compute/cutensor/2.0.2.1/local_installers/cutensor-local-repo-ubuntu2204-2.0.2_1.0-1_amd64.deb
    dpkg -i cutensor-local-repo-ubuntu2204-2.0.2_1.0-1_amd64.deb
    cp /var/cutensor-local-repo-ubuntu2204-2.0.2/cutensor-*-keyring.gpg /usr/share/keyrings/
    apt-get update
    apt-get install -y --no-install-recommends cuquantum-cuda-12 libcutensor1 libcutensor2 libcutensor-dev

    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel
    python3 -m pip install --no-cache-dir \
        bottle \
        colorama \
        'conan<2.0' \
        distro \
        fasteners \
        hatch \
        node-semver \
        patch-ng \
        pluginbase \
        pybind11 \
        PyJWT \
        'numpy>=2.0,<3' \
        'qiskit==2.5.2'
    git clone --depth 1 -b 0.17.2 https://github.com/Qiskit/qiskit-aer.git /tmp/qiskit-aer
    cd /tmp/qiskit-aer
    python3 ./setup.py bdist_wheel -- -DAER_THRUST_BACKEND=CUDA -DAER_PYTHON_CUDA_ROOT=qiskit-aer-venv
    python3 -m pip install --no-cache-dir dist/qiskit_aer-*.whl
    rm -rf /tmp/qiskit-aer

    QNI_WEBGPU_SOURCE_URL=${QNI_WEBGPU_SOURCE_URL:-https://github.com/qniapp/qni-webgpu/archive/refs/heads/master.tar.gz}
    mkdir -p /opt/qni-webgpu
    curl -L "${QNI_WEBGPU_SOURCE_URL}" -o /tmp/qni-webgpu.tar.gz
    tar -xzf /tmp/qni-webgpu.tar.gz --strip-components=1 -C /opt/qni-webgpu

    cd /opt/qni-webgpu
    python3 -m pip install --no-cache-dir --no-deps -e apps/qiskit-backend
    mkdir -p /etc/qni-webgpu
    cp deploy/docker/nginx.conf.template /etc/qni-webgpu/nginx.conf.template
    cp deploy/docker/docker-entrypoint.sh /usr/local/bin/qni-webgpu-entrypoint
    chmod +x /usr/local/bin/qni-webgpu-entrypoint
    cd apps/web
    pnpm install --frozen-lockfile
    /root/.cargo/bin/trunk build --release --public-url ./
    pnpm store prune

    rm -rf /tmp/qni-webgpu.tar.gz /root/.cargo/registry /root/.cargo/git /root/.cache /var/lib/apt/lists/* /var/cache/apt/archives

%runscript
    exec /usr/local/bin/qni-webgpu-entrypoint "$@"
